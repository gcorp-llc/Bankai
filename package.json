{
  "name": "bankai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Bankai Theme & Core Plugin",
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces",
    "lint:js": "wp-scripts lint-js",
    "lint:style": "wp-scripts lint-style",
    "build:zip": "node scripts/build-release.js"
  },
  "workspaces": [
    "themes/bankai-theme",
    "plugins/bankai-core",
    "packages/ui"
  ],
  "devDependencies": {
    "@wordpress/scripts": "^27.0.0"
  }
}