<!-- Tab 6: Generative AI Studio & Multi-LLM Orchestrator - GitHub Light Edition -->
<div id="tab-ai-studio" x-show="activeTab === 'ai'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100">
    <!-- View Header & Telemetry -->
    <div class="bankai-card" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding: 20px; flex-wrap: wrap; gap: 14px;">
        <div>
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 4px; flex-wrap: wrap;">
                <h2 style="font-size: 18px; font-weight: 800; color: #1F2328; margin: 0; display: flex; align-items: center; gap: 8px;">
                    <!-- Solar Broken Sparkles / Stars -->
                    <svg class="solar-icon" style="color: #0969DA;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2v3m0 14v3M2 12h3m14 0h3M4.93 4.93l2.12 2.12m9.9 9.9l2.12 2.12M4.93 19.07l2.12-2.12m9.9-9.9l2.12-2.12" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                    <span x-text="t('aiStudioTitle')">Generative AI Studio &amp; Multi-LLM Orchestrator</span>
                </h2>
                <span style="background-color: rgba(9, 105, 218, 0.15); border: 1px solid rgba(9, 105, 218, 0.35); color: #0969DA; font-size: 11px; padding: 3px 10px; border-radius: 12px; font-weight: 700; font-family: monospace;">
                    142,500 <span x-text="isRtl ? 'توکن مصرف‌شده این ماه (~$۰.۲۸)' : 'Tokens Used This Month (~$0.28)'">Tokens Used This Month (~$0.28)</span>
                </span>
            </div>
            <p style="font-size: 12px; color: #8C959F; margin: 0;" x-text="t('aiStudioSubtitle')">
                Orchestrate Gemini 2.0 Flash, GPT-4o, Claude 3.7, and DeepSeek R1 with prompt templates and automated workflow triggers.
            </p>
        </div>

        <button @click="testAiConnections()"
                style="background-color: #0969DA; border: none; color: #FFFFFF; padding: 10px 18px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 14px rgba(9, 105, 218, 0.35); transition: all 0.2s;">
            <!-- Solar Broken Bolt -->
            <svg class="solar-icon solar-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
            </svg>
            <span x-text="t('testApis')">Test API Connections</span>
        </button>
    </div>

    <!-- Provider Connection Badges Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <% state.providers.forEach(function(prov) { %>
            <div class="bankai-card bankai-card-interactive" style="padding: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                    <span style="font-size: 13px; font-weight: 700; color: #1F2328;"><%= prov.name %></span>
                    <span style="background-color: rgba(9, 105, 218, 0.15); color: #0969DA; font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 4px;">
                        <%= prov.badge %>
                    </span>
                </div>
                <div style="font-size: 11px; color: #8C959F;"><%= prov.models %></div>
            </div>
        <% }); %>
    </div>

    <!-- Multi-LLM Model & API Provider Configuration Panel -->
    <div class="bankai-card" style="padding: 24px; margin-bottom: 24px;">
        <h3 style="font-size: 15px; font-weight: 700; color: #1F2328; margin: 0 0 16px 0; display: flex; align-items: center; gap: 8px;">
            <!-- Solar Broken Key -->
            <svg class="solar-icon" style="color: #0969DA;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 2l-2 2m-1.5 1.5L14 9l-1.5-1.5L11 9l-1.5-1.5L8 9" />
                <circle cx="7.5" cy="15.5" r="5.5" />
            </svg>
            <span x-text="isRtl ? 'کلیدهای اتصال API و قوانین هماهنگی مدل‌ها' : 'Multi-LLM API Keys & Orchestration Rules'">Multi-LLM API Keys &amp; Orchestration Rules</span>
        </h3>

        <div class="bankai-grid-split" style="margin-bottom: 20px;">
            <div>
                <label style="display: block; font-size: 12px; font-weight: 700; color: #656D76; margin-bottom: 6px;">
                    OpenAI API Key
                </label>
                <div style="display: flex; gap: 8px; margin-bottom: 12px;">
                    <input :type="showApiKeys ? 'text' : 'password'" value="sk-proj-********************************"
                           style="flex: 1; background-color: #FFFFFF; border: 1px solid #D0D7DE; color: #1F2328; padding: 8px 12px; border-radius: 6px; font-size: 12px; font-family: monospace; outline: none;">
                    <button @click="showApiKeys = !showApiKeys" style="background-color: #F6F8FA; border: 1px solid #D0D7DE; color: #0969DA; padding: 8px 12px; border-radius: 6px; font-size: 11px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 4px;">
                        <svg class="solar-icon solar-icon-sm" style="width: 12px; height: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                        <span x-text="showApiKeys ? (isRtl ? 'مخفی' : 'Hide') : (isRtl ? 'نمایش' : 'Show')">Show</span>
                    </button>
                </div>

                <label style="display: block; font-size: 12px; font-weight: 700; color: #656D76; margin-bottom: 6px;">
                    Anthropic Claude API Key
                </label>
                <div style="display: flex; gap: 8px; margin-bottom: 12px;">
                    <input :type="showApiKeys ? 'text' : 'password'" value="sk-ant-********************************"
                           style="flex: 1; background-color: #FFFFFF; border: 1px solid #D0D7DE; color: #1F2328; padding: 8px 12px; border-radius: 6px; font-size: 12px; font-family: monospace; outline: none;">
                    <button @click="showApiKeys = !showApiKeys" style="background-color: #F6F8FA; border: 1px solid #D0D7DE; color: #0969DA; padding: 8px 12px; border-radius: 6px; font-size: 11px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 4px;">
                        <svg class="solar-icon solar-icon-sm" style="width: 12px; height: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                        <span x-text="showApiKeys ? (isRtl ? 'مخفی' : 'Hide') : (isRtl ? 'نمایش' : 'Show')">Show</span>
                    </button>
                </div>
            </div>

            <div>
                <label style="display: block; font-size: 12px; font-weight: 700; color: #656D76; margin-bottom: 6px;"
                       x-text="isRtl ? 'مدل هوش مصنوعی پیش‌فرض سیستم' : 'Primary Default Engine Model'">
                    Primary Default Engine Model
                </label>
                <select x-model="aiStudio.defaultModel"
                        style="width: 100%; background-color: #FFFFFF; border: 1px solid #D0D7DE; color: #1F2328; padding: 9px 12px; border-radius: 6px; font-size: 12px; margin-bottom: 12px; outline: none;">
                    <option value="gemini-2-flash">Google Gemini 2.0 Flash (بسیار سریع و بهینه)</option>
                    <option value="gpt-4o">OpenAI GPT-4o (دقت و سرعت بالا)</option>
                    <option value="claude-3-7-sonnet">Anthropic Claude 3.7 Sonnet (استدلال برتر)</option>
                    <option value="deepseek-r1">DeepSeek R1 (اقتصادی و استدلال تحلیلی)</option>
                </select>

                <div style="background-color: #F6F8FA; border: 1px solid #D0D7DE; padding: 12px 14px; border-radius: 8px; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 12px; color: #1F2328; font-weight: 600;"
                          x-text="isRtl ? 'مسیریابی خودکار جایگزین (Fallback) در صورت قطعی یا محدودیت' : 'Automatic Fallback Routing (If primary model rate-limited)'">
                        Automatic Fallback Routing (If primary model rate-limited)
                    </span>
                    <label class="bankai-switch">
                        <input type="checkbox" checked @change="showToast(isRtl ? 'مسیریابی جایگزین تغییر یافت' : 'Fallback Routing toggled')">
                        <span class="bankai-slider"></span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Live Interactive AI Generation Sandbox -->
        <div style="padding-top: 20px; border-top: 1px solid #D0D7DE;">
            <label style="display: block; font-size: 13px; font-weight: 700; color: #0969DA; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                <svg class="solar-icon solar-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2v3m0 14v3M2 12h3m14 0h3M4.93 4.93l2.12 2.12m9.9 9.9l2.12 2.12M4.93 19.07l2.12-2.12m9.9-9.9l2.12-2.12" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
                <span x-text="t('aiSandboxTitle')">Interactive AI Content &amp; Meta Generator (Powered by Server-Side Gemini API)</span>
            </label>
            <div style="display: flex; gap: 10px; margin-bottom: 12px; flex-wrap: wrap;">
                <input type="text" x-model="aiSandbox.promptInput" @keydown.enter="generateAiPrompt()"
                       :placeholder="isRtl ? 'عنوان نوشته وردپرس یا موضوع مورد نظر را برای تولید خودکار طرح سئو وارد کنید...' : 'Enter WordPress post title or topic to auto-generate SEO outline...'"
                       style="flex: 1; min-width: 260px; background-color: #FFFFFF; border: 1px solid #D0D7DE; color: #1F2328; padding: 10px 14px; border-radius: 8px; font-size: 13px; outline: none;">
                <button @click="generateAiPrompt()" :disabled="aiSandbox.isGenerating"
                        style="background-color: #0969DA; border: none; color: #FFFFFF; padding: 10px 20px; border-radius: 8px; font-size: 12px; font-weight: 800; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(9, 105, 218, 0.35);">
                    <svg class="solar-icon solar-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" /></svg>
                    <span x-show="!aiSandbox.isGenerating" x-text="t('generateNow')">Generate Now</span>
                    <span x-show="aiSandbox.isGenerating" x-text="t('generating')">Processing...</span>
                </button>
            </div>
            <div x-show="aiSandbox.aiResult" style="background-color: #F6F8FA; border: 1px solid #D0D7DE; border-radius: 8px; padding: 16px; font-size: 13px; color: #1F2328; line-height: 1.7; white-space: pre-wrap;" x-text="aiSandbox.aiResult"></div>
        </div>
    </div>

    <!-- Modular Feature Grid (6 Cards) -->
    <div class="bankai-grid-3" style="margin-bottom: 32px;">
        <% state.aiModules.forEach(function(mod) { %>
            <div class="bankai-card bankai-card-interactive" style="padding: 20px; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <!-- Top title + badge + switch -->
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(9, 105, 218, 0.12); display: flex; align-items: center; justify-content: center; color: #0969DA; flex-shrink: 0;">
                                <% if (mod.id === 'smart_excerpt_generator') { %>
                                    <svg class="solar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                                <% } else if (mod.id === 'llm_manifest_auto') { %>
                                    <svg class="solar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></svg>
                                <% } else if (mod.id === 'meta_desc_auto') { %>
                                    <svg class="solar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4V2m0 16v-2m8-7h-2M4 11H2m13.07-5.07l-1.41 1.41M5.34 16.66l-1.41 1.41m0-11.31l1.41 1.41m9.9 9.9l1.41 1.41M13 11l-9 9" /></svg>
                                <% } else if (mod.id === 'bulk_content_enricher') { %>
                                    <svg class="solar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2" /><polyline points="2 17 12 22 22 17" /><polyline points="2 12 12 17 22 12" /></svg>
                                <% } else if (mod.id === 'faq_schema_ai') { %>
                                    <svg class="solar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                                <% } else { %>
                                    <svg class="solar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                <% } %>
                            </div>
                            <div>
                                <div style="font-weight: 700; font-size: 14px; color: #1F2328;"
                                     x-text="isRtl ? ('<%= mod.title_fa || mod.title %>') : ('<%= mod.title %>')">
                                    <%= mod.title %>
                                </div>
                                <span style="background-color: rgba(9, 105, 218, 0.12); color: #0969DA; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 4px; display: inline-block; margin-top: 3px;">
                                    <%= mod.badge %>
                                </span>
                            </div>
                        </div>

                        <label class="bankai-switch">
                            <input type="checkbox"
                                   x-model="aiState.<%= mod.id %>"
                                   @change="toggleAiModule('<%= mod.id %>')">
                            <span class="bankai-slider"></span>
                        </label>
                    </div>

                    <!-- Description -->
                    <p style="font-size: 12px; color: #656D76; line-height: 1.5; margin: 0 0 16px 0;"
                       x-text="isRtl ? ('<%= mod.description_fa || mod.description %>') : ('<%= mod.description %>')">
                        <%= mod.description %>
                    </p>
                </div>

                <!-- Action / Settings Drawer Trigger -->
                <div style="border-top: 1px solid #D0D7DE; padding-top: 12px; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 11px; font-weight: 700;"
                          :style="aiState.<%= mod.id %> ? 'color: #1A7F37;' : 'color: #8C959F;'"
                          x-text="aiState.<%= mod.id %> ? t('active') : t('disabled')">
                        Active
                    </span>

                    <button @click="openAiDrawer('<%= mod.id %>', isRtl ? '<%= mod.title_fa || mod.title %>' : '<%= mod.title %>')"
                            style="background-color: #F6F8FA; border: 1px solid #D0D7DE; color: #0969DA; font-size: 11px; font-weight: 700; padding: 5px 12px; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 4px;">
                        <!-- Solar Broken Settings -->
                        <svg class="solar-icon solar-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3" />
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
                        </svg>
                        <span x-text="t('configure')">Configure</span>
                    </button>
                </div>
            </div>
        <% }); %>
    </div>

    <!-- AI Module Settings Modal Drawer -->
    <div x-show="aiDrawer.show" class="bankai-modal-overlay" style="display: none;" x-transition.opacity>
        <div @click.away="aiDrawer.show = false"
             class="bankai-card"
             style="width: 560px; max-width: 90%; padding: 28px; box-shadow: 0 20px 40px rgba(46, 52, 64, 0.25); position: relative;">
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #D0D7DE; padding-bottom: 16px;">
                <h3 style="font-size: 18px; font-weight: 800; color: #1F2328; margin: 0; display: flex; align-items: center; gap: 8px;">
                    <!-- Solar Broken Settings -->
                    <svg class="solar-icon" style="color: #0969DA;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
                    </svg>
                    <span x-text="aiDrawer.title + (isRtl ? ' - تنظیمات پرامپت و پرسونا' : ' Prompt Settings')"></span>
                </h3>
                <button @click="aiDrawer.show = false" style="background: none; border: none; color: #8C959F; font-size: 20px; cursor: pointer;">&times;</button>
            </div>

            <div style="margin-bottom: 24px; display: flex; flex-direction: column; gap: 16px;">
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 700; color: #656D76; margin-bottom: 6px;"
                           x-text="isRtl ? 'دستورالعمل سیستم و الگوی پرسونای هوش مصنوعی' : 'System Instructions & Persona Template'">
                        System Instructions &amp; Persona Template
                    </label>
                    <textarea rows="4" style="width: 100%; background-color: #FFFFFF; border: 1px solid #D0D7DE; color: #1F2328; padding: 10px; border-radius: 8px; font-size: 12px; font-family: monospace; outline: none; line-height: 1.6;">You are an expert editorial and SEO content strategist for WordPress.
Analyze the target subject "{post_title}" and write compelling meta titles and descriptions that maximize SERP CTR.</textarea>
                </div>

                <div>
                    <label style="display: block; font-size: 12px; font-weight: 700; color: #656D76; margin-bottom: 6px;"
                           x-text="isRtl ? 'برچسب‌های متغیر در دسترس' : 'Available Variable Tags'">
                        Available Variable Tags
                    </label>
                    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                        <span style="background-color: #F6F8FA; border: 1px solid #D0D7DE; padding: 4px 8px; border-radius: 4px; font-size: 11px; color: #0969DA; font-family: monospace;">{post_title}</span>
                        <span style="background-color: #F6F8FA; border: 1px solid #D0D7DE; padding: 4px 8px; border-radius: 4px; font-size: 11px; color: #0969DA; font-family: monospace;">{post_content}</span>
                        <span style="background-color: #F6F8FA; border: 1px solid #D0D7DE; padding: 4px 8px; border-radius: 4px; font-size: 11px; color: #0969DA; font-family: monospace;">{target_keyword}</span>
                        <span style="background-color: #F6F8FA; border: 1px solid #D0D7DE; padding: 4px 8px; border-radius: 4px; font-size: 11px; color: #0969DA; font-family: monospace;">{site_name}</span>
                    </div>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button @click="aiDrawer.show = false" style="background-color: #FFFFFF; border: 1px solid #D0D7DE; color: #656D76; padding: 10px 18px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;"
                        x-text="t('cancel')">
                    Cancel
                </button>
                <button @click="saveAiDrawerSettings()" style="background-color: #0969DA; border: none; color: #FFFFFF; padding: 10px 20px; border-radius: 8px; font-size: 12px; font-weight: 800; cursor: pointer; box-shadow: 0 4px 14px rgba(9, 105, 218, 0.35);"
                        x-text="isRtl ? 'ذخیره قوانین پرامپت' : 'Save Prompt Rules'">
                    Save Prompt Rules
                </button>
            </div>
        </div>
    </div>
</div>
