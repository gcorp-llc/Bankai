<!DOCTYPE html>
<html lang="<%= isRtl ? 'fa' : 'en' %>" dir="<%= isRtl ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bankai WordPress Ecosystem</title>
    <meta name="description" content="High-performance modular WordPress ecosystem with Alpine.js, SSR, SEO Engine, Speed Cache, Media Studio, and AI Content Suite.">

    <!-- Web Fonts: Inter & Vazirmatn (Persian RTL) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bankai Admin Core Styles - GitHub Light Theme -->
    <link rel="stylesheet" href="/css/bankai-admin.css">

    <style>
        [x-cloak] { display: none !important; }
        body {
            margin: 0;
            padding: 0;
            background-color: #F6F8FA;
            color: #1F2328;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', "Noto Sans", Roboto, sans-serif;
            overflow-x: hidden;
        }
        [dir="rtl"] body {
            font-family: 'Vazirmatn', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }
        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #F6F8FA;
        }
        ::-webkit-scrollbar-thumb {
            background: #D0D7DE;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #8C959F;
        }
        /* Switch styles - GitHub Primer Green/Blue */
        .bankai-switch {
            position: relative;
            display: inline-block;
            width: 38px;
            height: 22px;
        }
        .bankai-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        .bankai-slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #D0D7DE;
            transition: .22s;
            border-radius: 20px;
        }
        .bankai-slider:before {
            position: absolute;
            content: "";
            height: 16px;
            width: 16px;
            left: 3px;
            bottom: 3px;
            background-color: #FFFFFF;
            transition: .22s;
            border-radius: 50%;
            box-shadow: 0 1px 3px rgba(31, 35, 40, 0.25);
        }
        [dir="rtl"] .bankai-slider:before {
            left: auto;
            right: 3px;
        }
        input:checked + .bankai-slider {
            background-color: #1F883D;
        }
        input:checked + .bankai-slider:before {
            transform: translateX(16px);
        }
        [dir="rtl"] input:checked + .bankai-slider:before {
            transform: translateX(-16px);
        }
        .bankai-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: rgba(31, 35, 40, 0.45);
            backdrop-filter: blur(6px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 99999;
        }
    </style>

    <!-- Global Bridge Data for Alpine.js -->
    <script>
        window.bankaiData = {
            activeTab: '<%= initialTab %>',
            isRtl: <%= isRtl %>,
            restUrl: '/wp-json/bankai/v1',
            nonce: 'bankai-bridge-nonce'
        };

        // Universal global setTab handler
        window.setTab = function(tab) {
            if (window.bankaiAdminInstance) {
                window.bankaiAdminInstance.activeTab = tab;
                return window.bankaiAdminInstance.setTab(tab);
            }
            if (window.bankaiData) {
                window.bankaiData.activeTab = tab;
            }
            const app = document.getElementById('bankai-admin-app');
            if (app && window.Alpine) {
                try {
                    const data = window.Alpine.$data(app);
                    if (data) {
                        data.activeTab = tab;
                        if (typeof data.setTab === 'function') {
                            return data.setTab(tab);
                        }
                    }
                } catch(e) {}
            }
        };

        window.showToast = function(msg, type = 'success') {
            if (window.bankaiAdminInstance && typeof window.bankaiAdminInstance.showToast === 'function') {
                return window.bankaiAdminInstance.showToast(msg, type);
            }
            console.log('[Bankai Toast]', type, msg);
        };
    </script>

    <!-- Bankai Admin & Alpine.js Scripts -->
    <script src="/js/htmx.min.js" defer></script>
    <script src="/js/bankai-admin.js"></script>
    <script src="/js/alpine.min.js" defer></script>
</head>
<body>
    <div id="bankai-admin-app" class="bankai-admin-wrap" x-data="bankaiAdmin()" x-cloak>
        <!-- Ambient Decorative Animated Background Elements (GitHub Light Aesthetic) -->
        <div class="bankai-bg-decorations" aria-hidden="true">
            <div class="bankai-ambient-grid"></div>
            <div class="bankai-ambient-orb bankai-orb-1"></div>
            <div class="bankai-ambient-orb bankai-orb-2"></div>
            <div class="bankai-ambient-orb bankai-orb-3"></div>
            <div class="bankai-ambient-particles">
                <span class="bankai-particle p-1"></span>
                <span class="bankai-particle p-2"></span>
                <span class="bankai-particle p-3"></span>
                <span class="bankai-particle p-4"></span>
                <span class="bankai-particle p-5"></span>
            </div>
        </div>

        <!-- Toast Notification -->
        <%- include('partials/toast') %>

        <!-- Mobile Drawer Backdrop Overlay -->
        <div class="bankai-mobile-overlay"
             x-show="mobileMenuOpen"
             @click="closeMobileMenu()"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             x-cloak></div>

        <!-- Top Header Navigation -->
        <%- include('partials/header') %>

        <!-- Main Body Layout: Floating Canvas with Margins from Header & Edges -->
        <div class="bankai-body-layout">
            <!-- Sidebar Navigation (Floating Card) -->
            <%- include('partials/sidebar') %>

            <!-- Main Tabbed Viewport (Floating Content Area) -->
            <main id="bankai-main-content">
                <%- include('partials/tab-overview') %>
                <%- include('partials/tab-theme-kits') %>
                <%- include('partials/tab-seo-engine') %>
                <%- include('partials/tab-speed-cache') %>
                <%- include('partials/tab-media-watermark') %>
                <%- include('partials/tab-ai-studio') %>
                <%- include('partials/tab-settings-license') %>
            </main>
        </div>
    </div>
</body>
</html>
